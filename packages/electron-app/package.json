{
  "name": "todoboard-electron",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "unset ELECTRON_RUN_AS_NODE && electron-vite build && electron-builder",
    "pack:appimage": "unset ELECTRON_RUN_AS_NODE && electron-vite build && electron-builder --linux AppImage",
    "preview": "unset ELECTRON_RUN_AS_NODE && electron-vite preview"
  },
  "dependencies": {
    "todoboard-core": "*",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "electron": "28.3.3",
    "electron-builder": "^24.9.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.0.0",
    "vite": "5.0.0",
    "vue-tsc": "^3.0.8"
  }
}
